# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
.venv/

# --- Tool caches ------------------------------------------------------------
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Generated artifacts ----------------------------------------------------
# Runs, campaigns and figures are regenerated by `make study`, `make sweeps`
# and `make figures`, and the frozen study bundle is archived on Zenodo.
outputs/
logs/
dist/

# --- Licensed third-party data ----------------------------------------------
# M5 terms do not permit redistribution. Regenerate locally with `make m5`.
# Only the README explaining how to do so is tracked.
data/demand/*
!data/demand/README.md

